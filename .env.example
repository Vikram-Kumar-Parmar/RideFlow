# RideFlow — environment configuration
# ----------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# DB_TARGET picks which connection block is used: "mysql" or "tidb".
# ----------------------------------------------------------------------

DB_TARGET=mysql

# ---- LOCAL MYSQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=databaseProject_db

# ---- TiDB CLOUD (for the +5 bonus) ----
# Grab from: TiDB Cloud → Cluster → Connect → General
# NOTE: TiDB does NOT support stored procedures, triggers, or events.
# When DB_TARGET=tidb the setup script will skip schema/04..06 and warn.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=databaseProject_db
TIDB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# ---- App ----
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
